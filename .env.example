# Токен бота від @BotFather
BOT_TOKEN=123456789:AAAA-your-token-here

# Безкоштовний ключ з https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Ключ Entrim AI (платно): текстові запити підуть на GLM 5.3 Flash. Порожньо — працює Groq
ENTRIM_API_KEY=

# Ваш Telegram ID (дізнатись: @userinfobot), дає доступ до команди /analytics
ADMIN_IDS=

# Хмарна база Turso (адреса libsql://... і токен), щоб дані не стирались. Порожньо — база у файлі bot.db
TURSO_URL=
TURSO_AUTH_TOKEN=

# Необов'язково:
# ENTRIM_MODEL=zai-org/GLM-5.3-Flash
# GROQ_MODEL=openai/gpt-oss-120b
# WHISPER_MODEL=whisper-large-v3-turbo
# TTS_VOICE=en-US-AriaNeural
# DAILY_HOUR=19
# CLUB_LINK=https://t.me/engspeakingclub2
